# Installe les dépendances séparément pour profiter du cache de construction Docker.
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG API_INTERNAL_URL=http://api:8000
ENV API_INTERNAL_URL=$API_INTERNAL_URL
# Laisser cette URL vide si Next.js relaie les appels /api vers le backend.
ARG NEXT_PUBLIC_API_URL=
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NODE_ENV=production
# Compile la version de production dans l'image, puis la sert avec Next.js.
RUN npm run build
EXPOSE 3000
CMD ["npm", "start"]
