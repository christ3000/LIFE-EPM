# Copy this file to .env and replace every placeholder before starting the application.
# Do not commit .env or reuse these placeholders as production secrets.
# Use a unique 64-character hexadecimal password for the local PostgreSQL role.
LIFE_EPM_DATABASE_PASSWORD=replace-with-a-64-character-hex-secret
LIFE_EPM_JWT_SECRET=replace-with-at-least-32-random-characters
LIFE_EPM_ADMIN_USERNAME=pasteur.bobou
LIFE_EPM_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
LIFE_EPM_ADMIN_FULL_NAME=Pasteur BOBOU Josué E.
LIFE_EPM_DEMO_DATA_ENABLED=false
LIFE_EPM_CHURCH_NAME=Église Pentecôte Missionnaire
LIFE_EPM_CHURCH_INITIALS=EPM
LIFE_EPM_CHURCH_CITY=Abidjan
LIFE_EPM_FRONTEND_ORIGIN=http://localhost:3000
LIFE_EPM_COOKIE_SECURE=false
NEXT_PUBLIC_API_URL=
LIFE_EPM_SMS_PROVIDER=disabled
LIFE_EPM_SMS_USERNAME=
LIFE_EPM_SMS_API_KEY=
LIFE_EPM_SMS_SENDER=
LIFE_EPM_SMS_SANDBOX=true
